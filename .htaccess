# Configuration for Hostinger LiteSpeed / Apache Direct Serving & Node Proxy Fallback
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Default document index
    DirectoryIndex index.html public/index.html

    # If requested file exists in root or public, serve directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # If requested file exists in public directory
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
    RewriteRule ^(.+)$ public/$1 [L]
</IfModule>
